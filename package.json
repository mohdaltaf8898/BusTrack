    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/leaflet": "1.9.22",
    "@types/node": "22.15.30",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.21",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.28",
