# -----------------------------------------------------------------------------
# BusTrack environment template — DO NOT PUT REAL SECRETS IN THIS FILE.
# Copy to `.env.local` for development. All values below are placeholders.
# -----------------------------------------------------------------------------

# Leave these unset to run the complete, credential-free DEMO MODE.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Never prefix this with NEXT_PUBLIC_, and never commit it.
# Required only for the optional real GPS / admin API routes.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL used in documentation and metadata (optional).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Demo-only tuning. These are public, non-secret values.
NEXT_PUBLIC_SIMULATION_SPEED_MULTIPLIER=8
NEXT_PUBLIC_STALE_LOCATION_SECONDS=45
